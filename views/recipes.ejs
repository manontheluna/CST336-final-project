<section class="recipes-page">

    <!-- Recipe page introduction -->
    <div class="recipes-header">

        <p class="recipes-label">Cook With What You Have</p>

        <h1>Find Recipes</h1>

        <p class="recipes-description">Enter ingredients you already have and discover recipes you
            can make with them.
        </p>
    </div>

    <!-- Recipe search area -->

    <div class="recipe-search-card">


        <form id="recipe-form">
            <label for="recipe-search">Enter ingredients separated by commas:</label>

            <div class="recipe-search-row">

                <input type="text" id="recipe-search" name="ingredients" placeholder="Example: chicken, rice, tomatoes">

                <button class="recipe-search-button" type="submit">Search</button>
            </div>
        </form>

        <!-- Displays loading, error, or no-results messages -->
        <p id="recipe-message"></p>

    </div>

    <!-- Recipe results area -->
    <section class="recipe-results-section">

        <div class="recipe-results-heading">

            <h2>Recipe Suggestions</h2>
            
        </div>

        <div id="recipe-results"></div>
    </section>

</section>

<script src="/js/storage.js" defer></script>
<script src="/js/recipe-api.js" defer></script>