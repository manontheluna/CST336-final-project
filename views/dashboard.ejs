<div class="dashboard">


    <!-- Wraps the user's name, email, and logout link
         so we can style the dashboard header. -->
    <div class="dashboard-header">


        <!-- Groups the user's name and email together. -->
        <div class="dashboard-user-info">

            <h1>
                <%= user.firstName %>
                    <%= user.lastName %>
            </h1>

            <p>
                <%= user.email %>
            </p>

        </div>

        <!-- Added class only for styling. -->
        <!-- Logout link -->
        <a class="dashboard-logout" href="/logout">
            Logout
        </a>

    </div>
    <!-- End dashboard-header -->



    <!-- This wrapper will control the overall dashboard layout. -->
    <div class="dashboard-grid">



        <!-- Added dashboard-card class only for styling. -->
        <div class="pantry dashboard-card">

            <strong>Pantry:</strong>

            <ul class="pantry-items">

                <% for(let item of pantryItems) { %>

                    <li>

                        <%= item.name %>

                            <span>
                                <%= item.quantity %>
                            </span>

                            <span>
                                <%= item.unit %>
                            </span>

                            <span>
                                <%= item.expirationDate %>
                            </span>

                            <button class="edit-pantry" data-type="pantry"
                                data-ingredient='<%= JSON.stringify(item) %>'>
                                Edit
                            </button>

                            <form action="/ingredients/delete/<%= item.id %>" method="POST">


                                <!-- Added class only for styling. -->
                                <button class="dashboard-delete-button">
                                    Delete
                                </button>

                            </form>

                    </li>

                    <% } %>

            </ul>

        </div>


        <!-- Existing ADD/UPDATE ingridient section
             Added dashboard-card class only for styling.
        -->
        <div class="add-new-ingredient dashboard-card">

            Add/Update new ingredient

            <form id="ingredientForm" action="/ingredients/add" method="POST">

                <input type="hidden" name="_method">

                <label>Name</label>

                <input type="text" name="ingredientName" placeholder="Ingredient Name">

                <label>Description</label>

                <input type="text" name="description" placeholder="Ingredient Description">

                <label>Quantity</label>

                <input type="number" name="quantity" placeholder="Quantity">

                <label>Unit</label>

                <select name="unit">
                    <option value="block">block</option>
                    <option value="count">count</option>
                    <option value="lbs">lbs</option>
                    <option value="oz">oz</option>
                    <option value="gallons">gallons</option>
                </select>

                <label>Expiration Date</label>

                <input type="date" name="expiration">


                <!-- Added class only for styling. -->

                <button class="dashboard-primary-button" type="submit">
                    Add
                </button>

            </form>

        </div>


        <!-- Existing grocery section
             Added dashboard-card class only for styling.
        -->
        <div class="groceries dashboard-card">

            <strong>Grocery Lists</strong>

            <ul class="grocery-lists">

                <% for(let item of groceries) { %>

                    <!-- 
                         Added grocery-list-card class only for styling.
                    -->
                    <li class="grocery-list-card">

                        <div>

                            <strong>
                                <%= item.name %>
                            </strong>

                            <label>
                                Completed:

                                <input class="completed" type="checkbox" name="<%= item.id %>" <%=item.isCompleted
                                    ? 'checked' : '' %>
                                >

                            </label>

                            <% for (let i of item.items) { %>

                                <!-- 
                                     Added class only for styling.
                                -->
                                <div class="grocery-list-item">

                                    <%= i.name %>
                                        <%= i.quantity %>
                                            <%= i.unit %>

                                </div>

                                <% } %>

                        </div>


                        <strong>Add New Item to List</strong>

                        <form action="/api/grocery-items/add/" method="POST">

                            <input type="hidden" name="id" value="<%= item.id %>">

                            <label>
                                Item Name

                                <input type="text" name="name">

                            </label>

                            <label>
                                Quantity

                                <input type="number" name="quantity">

                            </label>

                            <label>
                                Unit

                                <select name="unit">
                                    <option value="block">block</option>
                                    <option value="count">count</option>
                                    <option value="lbs">lbs</option>
                                    <option value="oz">oz</option>
                                    <option value="gallons">gallons</option>
                                </select>

                            </label>

                            <!-- 
                                 Added class only for styling.
                            -->
                            <button class="dashboard-primary-button">
                                Add New List Item
                            </button>

                        </form>


                        <form action="/groceries/delete/<%= item.id %>" method="POST">

                            <!-- 
                                 Added class only for styling.
                            -->
                            <button class="dashboard-delete-button">
                                Delete List
                            </button>

                        </form>

                    </li>

                    <% } %>

            </ul>


            <!-- 
                 Wrapper only for styling the add-new-list section.
            -->
            <div class="new-grocery-list">

                <strong>Add New Grocery List</strong>

                <form action="/groceries/add" method="POST">

                    <label for="name">

                        Grocery List Name

                        <input id="name" type="text" name="name">

                    </label>

                    <!-- 
                         Added class only for styling.
                    -->
                    <button class="dashboard-primary-button">
                        Add New Grocery List
                    </button>

                </form>

            </div>
            <!-- End: new-grocery-list -->


        </div>
    </div>
    <!-- End: dashboard-grid -->


</div>